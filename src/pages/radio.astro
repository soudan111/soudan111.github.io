---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpinitronArchive from "../components/SpinitronArchive.astro";
import { site } from "../data/site";
import { radio } from "../data/radio";
---

<BaseLayout
  title={`Radio — ${site.name}`}
  description={`Playlist archive for ${radio.showName} on ${radio.stationName}.`}
  current="radio"
>
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">{radio.stationName} · {radio.stationDetail}</p>
      <h1 class="display">{radio.showName}.</h1>
      <p class="lead">
        I have hosted {radio.showName} as {radio.djName} on {radio.stationName} since 2023, and previously hosted The Pound and the Pines (2023-2025) with DJ Dog House. Most
        episodes' playlists are archived below, though some merge troubles and pre-2025 shows were logged elsewhere. Pick any show to see the full
        track list. Playlists are hosted by Spinitron.
      </p>
    </div>

    <section class="page-section">
      <SpinitronArchive />
      <p class="archive-note">
        Audio from past shows, where available, is controlled by
        {radio.stationName} and may only be offered for a limited time.
      </p>
    </section>
  </div>
</BaseLayout>
