---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { withBase } from "../utils/url";

const education = [
  {
    date: "2023 – Present",
    title: "PhD, Plant Biology",
    meta: "UC Davis · Advisor: Dr. Blake Meyers",
  },
  {
    date: "2019 – 2023",
    title: "B.S., Genetics and Plant Biology ",
    meta: "UC Berkeley",
  },
{
    date: "2019 – 2023",
    title: "B.A., Classical Civilizations ",
    meta: "UC Berkeley",
  },
];

const teaching = [
  {
    date: "Fall 2025",
    title: "Teaching assistant, PLB 105 - Developmental Plant Anatomy",
    meta: "UC Davis",
  },
];

const awards = [
  {
    date: "2023-2028",
    title: "NSF Graduate Research Fellowship",
    meta: "National Science Foundation",
  },
 {
    date: "2025-2029",
    title: "Plant Sciences GSR Award",
    meta: "UC Davis Plant Sciences Department",
  },
];

const sections = [
  { heading: "Education", items: education },
  { heading: "Teaching", items: teaching },
  { heading: "Awards & funding", items: awards },
];
---

<BaseLayout
  title={`CV — ${site.name}`}
  description="Curriculum vitae: education, teaching, and awards."
  current="cv"
>
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">Curriculum vitae</p>
      <h1 class="display">CV highlights.</h1>
      <p class="lead">
        A summary of education, teaching, and awards. The full CV, including
        publications and presentations, is available as a PDF.
      </p>
      <div class="actions">
        <a class="button-link primary" href={withBase("cv.pdf")}>
          Download CV (PDF) ↓
        </a>
      </div>
    </div>

    {
      sections.map((s) => (
        <section class="page-section">
          <h2>{s.heading}</h2>
          <ul class="entry-list">
            {s.items.map((item) => (
              <li>
                <span class="entry-date">{item.date}</span>
                <div>
                  <p class="entry-title">{item.title}</p>
                  <p class="entry-meta">{item.meta}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
