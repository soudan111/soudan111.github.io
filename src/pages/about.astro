---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { withBase } from "../utils/url";
import Letterboxd from "../components/Letterboxd.astro";
import Hevy from "../components/Hevy.astro";
---

<BaseLayout
  title={`About — ${site.name}`}
  description="Academic biography and personal interests."
  current="about"
>
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">About</p>
      <h1 class="display">A little more about me.</h1>
    </div>

    <section class="page-section about-grid">
      <div class="reading">
        <h2>Academic background</h2>
        <p>
          I am a fourth-year PhD candidate in Blake Meyers' lab at the UC Davis Genome Center studying small RNA control of male fertility. 
        </p>
        <p>
          Mention your advisor or lab, your institution, and the questions you
          hope to answer over the next few years.
        </p>
      </div>

      <img
        class="project-image"
        src={withBase("images/beyond-lab.svg")}
        alt="A personal photograph"
        width="900"
        height="540"
        loading="lazy"
      />
    </section>

    <section class="page-section">
      <div class="reading">
        <h2>Beyond the lab</h2>
        <p>
          In my free time, I like to watch movies, go to the gym, talk on the radio @ KDVS 90.3FM , and make art when I can! 
        </p>
        <p>
          Add two or three candid photographs below by dropping them into
          <code>public/images/</code> and referencing them here.
        </p>
      </div>
    </section>
    <Letterboxd />
  <Hevy />
  </div>
</BaseLayout>
